{
  "name": "astro-resume",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "postinstall": "npx playwright install",
    "start": "astro dev",
    "generate-pdf": "dotenv -- node ./scripts/generate-pdf.js",
    "generate-pdf:ci": "PDF_VIEW=true start-server-and-test http://localhost:4321 generate-pdf",
    "prebuild": "astro check && tsc --noEmit",
    "build": "npm run generate-pdf:ci && astro build"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.7",
    "@astrojs/mdx": "^5.0.0",
    "@astrojs/netlify": "^7.0.2",
    "@tailwindcss/vite": "^4.2.1",
    "astro": "^6.0.4",
    "astro-icon": "^1.1.5",
    "marked": "^17.0.4",
    "moment": "^2.30.1",
    "tailwindcss": "^4.1.8"
  },
  "devDependencies": {
    "@netlify/plugin-lighthouse": "^6.0.4",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^25.5.0",
    "dotenv-cli": "^8.0.0",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "start-server-and-test": "^2.1.5",
    "theme-change": "^2.5.0",
    "typescript": "^5.8.3"
  }
}
